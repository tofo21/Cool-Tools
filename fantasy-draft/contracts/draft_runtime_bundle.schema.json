{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tofo21.github.io/Cool-Tools/fantasy-draft/contracts/draft_runtime_bundle.schema.json",
  "title": "Draft Command Browser Runtime Bundle",
  "description": "Compact, public-safe join of Player Truth, ESPN market, ESPN League Value, and Opponent Intent artifacts.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "bundleVersion",
    "generatedAt",
    "status",
    "overallStatus",
    "modelState",
    "sourceCommits",
    "sourceArtifacts",
    "coverage",
    "confidencePolicy",
    "leagueConfiguration",
    "playerRecords",
    "marketRecords",
    "leagueValueRecords",
    "opponentIntent",
    "featureAvailability",
    "knownLimitations",
    "fallbackPolicy",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "draft-runtime-bundle" },
    "bundleVersion": { "type": "string", "pattern": "^runtime-[a-f0-9]{16}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "$ref": "#/$defs/artifactStatus" },
    "overallStatus": { "enum": ["ready", "degraded", "rejected"] },
    "modelState": { "enum": ["ready", "fallback", "rejected"] },
    "sourceCommits": { "type": "array", "items": { "type": "string", "minLength": 7 }, "uniqueItems": true },
    "sourceArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifactType", "artifactId", "artifactVersion", "schemaVersion", "status", "fileSha256", "payloadSha256"],
        "properties": {
          "artifactType": { "enum": ["player-truth", "espn-market", "espn-league-value", "opponent-intent"] },
          "artifactId": { "type": "string", "minLength": 1 },
          "artifactVersion": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/artifactStatus" },
          "fileSha256": { "$ref": "#/$defs/sha256" },
          "payloadSha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "confidencePolicy": {
      "type": "object",
      "required": ["playerTruthMinimum", "identityMinimum", "leagueValueMinimum", "opponentPredictionLabels", "nullMeansMissing"],
      "properties": {
        "playerTruthMinimum": { "$ref": "#/$defs/probability" },
        "identityMinimum": { "$ref": "#/$defs/probability" },
        "leagueValueMinimum": { "$ref": "#/$defs/probability" },
        "opponentPredictionLabels": {
          "type": "array",
          "items": { "enum": ["calibrated", "contextual", "unvalidated", "fallback"] },
          "uniqueItems": true
        },
        "nullMeansMissing": { "const": true }
      },
      "additionalProperties": false
    },
    "leagueConfiguration": { "$ref": "#/$defs/leagueConfiguration" },
    "playerRecords": { "type": "array", "items": { "$ref": "#/$defs/playerRecord" } },
    "marketRecords": { "type": "array", "items": { "$ref": "#/$defs/marketRecord" } },
    "leagueValueRecords": { "type": "array", "items": { "$ref": "#/$defs/leagueValueRecord" } },
    "opponentIntent": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/opponentIntent" }] },
    "featureAvailability": {
      "type": "object",
      "required": ["playerTruth", "leagueValue", "espnRank", "espnAdp", "opponentIntent", "roomSurvival", "manualDraft"],
      "properties": {
        "playerTruth": { "type": "boolean" },
        "leagueValue": { "type": "boolean" },
        "espnRank": { "type": "boolean" },
        "espnAdp": { "type": "boolean" },
        "opponentIntent": { "type": "boolean" },
        "roomSurvival": { "type": "boolean" },
        "manualDraft": { "const": true }
      },
      "additionalProperties": false
    },
    "knownLimitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "fallbackPolicy": {
      "type": "object",
      "required": ["playerTruthFailure", "espnMarketFailure", "leagueValueFailure", "opponentIntentFailure", "playerMismatch", "bundleIncompatibility"],
      "properties": {
        "playerTruthFailure": { "const": "provisional-labeled-valuation" },
        "espnMarketFailure": { "const": "manual-board-without-market" },
        "leagueValueFailure": { "const": "provisional-labeled-valuation" },
        "opponentIntentFailure": { "const": "hide-or-downgrade-threats" },
        "playerMismatch": { "const": "exclude-affected-join-and-continue" },
        "bundleIncompatibility": { "const": "reject-bundle-preserve-draft-tracking" }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": ["applicationId", "minimumApplicationRelease", "supportedSchemaMajor", "requiredCapabilities", "persistencePolicy"],
      "properties": {
        "applicationId": { "const": "draft-command" },
        "minimumApplicationRelease": { "type": "string", "minLength": 1 },
        "supportedSchemaMajor": { "const": 1 },
        "requiredCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "persistencePolicy": { "const": "bundle-fetch-only-no-localStorage" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifactStatus": { "enum": ["candidate", "validated", "frozen", "fallback", "rejected"] },
    "probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableProbability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coverageSlice": {
      "type": "object",
      "required": ["eligible", "playerTruth", "marketRank", "marketAdp", "leagueValue"],
      "properties": {
        "eligible": { "type": "integer", "minimum": 0 },
        "playerTruth": { "type": "integer", "minimum": 0 },
        "marketRank": { "type": "integer", "minimum": 0 },
        "marketAdp": { "type": "integer", "minimum": 0 },
        "leagueValue": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["overall", "byPosition", "byBoardRange", "keeperIdentities", "unresolvedIdentities"],
      "properties": {
        "overall": { "$ref": "#/$defs/coverageSlice" },
        "byPosition": {
          "type": "object",
          "required": ["QB", "RB", "WR", "TE"],
          "properties": {
            "QB": { "$ref": "#/$defs/coverageSlice" },
            "RB": { "$ref": "#/$defs/coverageSlice" },
            "WR": { "$ref": "#/$defs/coverageSlice" },
            "TE": { "$ref": "#/$defs/coverageSlice" }
          },
          "additionalProperties": false
        },
        "byBoardRange": {
          "type": "object",
          "required": ["1-50", "51-100", "101-160", "161+"],
          "properties": {
            "1-50": { "$ref": "#/$defs/coverageSlice" },
            "51-100": { "$ref": "#/$defs/coverageSlice" },
            "101-160": { "$ref": "#/$defs/coverageSlice" },
            "161+": { "$ref": "#/$defs/coverageSlice" }
          },
          "additionalProperties": false
        },
        "keeperIdentities": {
          "type": "object",
          "required": ["resolved", "expected"],
          "properties": {
            "resolved": { "type": "integer", "minimum": 0 },
            "expected": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "unresolvedIdentities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["internalPlayerId", "boardRank", "artifactType", "blocking", "reason"],
            "properties": {
              "internalPlayerId": { "type": "integer", "minimum": 1 },
              "boardRank": { "type": "integer", "minimum": 1 },
              "artifactType": { "enum": ["player-truth", "espn-market", "espn-league-value", "opponent-intent"] },
              "blocking": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "keeper": {
      "type": "object",
      "required": ["teamId", "internalPlayerId", "round", "overallPick"],
      "properties": {
        "teamId": { "type": "string", "pattern": "^team-[0-9]{2}$" },
        "internalPlayerId": { "type": "integer", "minimum": 1 },
        "round": { "type": "integer", "minimum": 1 },
        "overallPick": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "leagueConfiguration": {
      "type": "object",
      "required": ["leagueId", "leagueSettingsVersion", "settingsHash", "scoringFormat", "rosterFormat", "teamCount", "rounds", "draftSlot", "totalPicks", "tonyTeamId", "tonyFirstPick", "keepers"],
      "properties": {
        "leagueId": { "type": "string", "minLength": 1 },
        "leagueSettingsVersion": { "type": "string", "minLength": 1 },
        "settingsHash": { "$ref": "#/$defs/sha256" },
        "scoringFormat": { "type": "string", "minLength": 1 },
        "rosterFormat": { "type": "object", "additionalProperties": true },
        "teamCount": { "const": 10 },
        "rounds": { "const": 16 },
        "draftSlot": { "const": 5 },
        "totalPicks": { "const": 160 },
        "tonyTeamId": { "const": "team-05" },
        "tonyFirstPick": { "const": 5 },
        "keepers": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/keeper" } }
      },
      "additionalProperties": false
    },
    "playerRecord": {
      "type": "object",
      "required": ["internalPlayerId", "boardRank", "canonicalPlayerKey", "espnPlayerId", "name", "nflTeam", "position", "identity", "outcome", "availability", "modelConfidence", "features", "provenance", "limitations"],
      "properties": {
        "internalPlayerId": { "type": "integer", "minimum": 1 },
        "boardRank": { "type": "integer", "minimum": 1 },
        "canonicalPlayerKey": { "type": "string", "minLength": 1 },
        "espnPlayerId": { "type": ["string", "null"], "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "nflTeam": { "type": "string", "minLength": 2 },
        "position": { "enum": ["QB", "RB", "WR", "TE"] },
        "identity": {
          "type": "object",
          "required": ["method", "confidence"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/probability" }
          },
          "additionalProperties": false
        },
        "outcome": {
          "type": "object",
          "required": ["projectedFullPprPoints", "projectedPpg", "expectedGames", "p10", "p50", "p90", "eliteProbability", "starterProbability", "bustProbability"],
          "properties": {
            "projectedFullPprPoints": { "type": "number", "minimum": 0 },
            "projectedPpg": { "type": "number", "minimum": 0 },
            "expectedGames": { "type": "number", "minimum": 0, "maximum": 17 },
            "p10": { "type": ["number", "null"], "minimum": 0 },
            "p50": { "type": ["number", "null"], "minimum": 0 },
            "p90": { "type": ["number", "null"], "minimum": 0 },
            "eliteProbability": { "$ref": "#/$defs/nullableProbability" },
            "starterProbability": { "$ref": "#/$defs/nullableProbability" },
            "bustProbability": { "$ref": "#/$defs/nullableProbability" }
          },
          "additionalProperties": false
        },
        "availability": {
          "type": "object",
          "required": ["status", "confidence"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "confidence": { "$ref": "#/$defs/probability" }
          },
          "additionalProperties": false
        },
        "modelConfidence": { "$ref": "#/$defs/probability" },
        "features": {
          "type": "object",
          "required": ["eligible", "quarantined"],
          "properties": {
            "eligible": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "quarantined": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "provenance": { "type": "object", "additionalProperties": true },
        "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "marketRecord": {
      "type": "object",
      "required": ["internalPlayerId", "espnPlayerId", "defaultRank", "continuousAdp", "liveRoomRank", "ordinalAdpRank", "captureStatus", "mappingConfidence"],
      "properties": {
        "internalPlayerId": { "type": "integer", "minimum": 1 },
        "espnPlayerId": { "type": ["string", "null"] },
        "defaultRank": { "type": ["integer", "null"], "minimum": 1 },
        "continuousAdp": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "liveRoomRank": { "type": ["integer", "null"], "minimum": 1 },
        "ordinalAdpRank": { "type": ["integer", "null"], "minimum": 1 },
        "captureStatus": { "type": "string", "minLength": 1 },
        "mappingConfidence": { "$ref": "#/$defs/probability" }
      },
      "additionalProperties": false
    },
    "leagueValueRecord": {
      "type": "object",
      "required": ["internalPlayerId", "projectedLeaguePoints", "replacementValueByPosition", "marginalValue", "flexAdjustedValue", "leagueValueScore", "leagueValueRank", "positionalRank", "rosterFitAdjustment", "confidence", "status"],
      "properties": {
        "internalPlayerId": { "type": "integer", "minimum": 1 },
        "projectedLeaguePoints": { "type": "number" },
        "replacementValueByPosition": { "type": "number" },
        "marginalValue": { "type": "number" },
        "flexAdjustedValue": { "type": "number" },
        "leagueValueScore": { "type": "number" },
        "leagueValueRank": { "type": "integer", "minimum": 1 },
        "positionalRank": { "type": "integer", "minimum": 1 },
        "rosterFitAdjustment": { "type": ["number", "null"] },
        "confidence": { "$ref": "#/$defs/probability" },
        "status": { "$ref": "#/$defs/artifactStatus" }
      },
      "additionalProperties": false
    },
    "opponentIntent": {
      "type": "object",
      "required": ["modelArtifactVersion", "simulation", "opponents", "targetSurvival", "tierSurvival"],
      "properties": {
        "modelArtifactVersion": { "type": "string", "minLength": 1 },
        "simulation": { "type": "object", "additionalProperties": true },
        "opponents": { "type": "object", "additionalProperties": true },
        "targetSurvival": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "tierSurvival": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
